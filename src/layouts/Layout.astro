---
import "../styles/tokens.css";

interface Props {
  title?: string;
  description?: string;
  ogDescription?: string;
  noindex?: boolean;
}

const {
  title = "Pedro Cordeiro Lima — Desenvolvedor e Integrador de Sistemas em Hortolândia e Campinas",
  description = "Desenvolvedor em Hortolândia, SP. Integro sistemas e automatizo processos para pequenas e médias empresas de Campinas e região — sem você precisar de uma equipe de TI.",
  ogDescription,
  noindex = false,
} = Astro.props;

const resolvedOgDescription = ogDescription ?? description;

const canonicalUrl = new URL(Astro.url.pathname, "https://cordeirolima.net")
  .href;
const ogImage = "https://cordeirolima.net/og-image.jpg";

const siteUrl = "https://cordeirolima.net";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    url: siteUrl,
    name: "Pedro Cordeiro Lima",
    inLanguage: "pt-BR",
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${siteUrl}/#pedro`,
    name: "Pedro Cordeiro Lima",
    url: siteUrl,
    email: "pedro@cordeirolima.net",
    telephone: "+5519993748304",
    image: `${siteUrl}/og-image.jpg`,
    jobTitle: "Desenvolvedor & Integrador de Sistemas",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Hortolândia",
      addressRegion: "SP",
      addressCountry: "BR",
    },
    sameAs: [
      "https://linkedin.com/in/pedro-cordeiro",
      "https://github.com/PClima",
    ],
    knowsAbout: [
      "Integração de sistemas",
      "Automação de processos",
      "Desenvolvimento de sites",
      "Desenvolvimento backend",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "@id": `${siteUrl}/#service`,
    name: "Pedro Cordeiro Lima — Integração de Sistemas e Automação",
    url: siteUrl,
    image: `${siteUrl}/og-image.jpg`,
    email: "pedro@cordeirolima.net",
    telephone: "+5519993748304",
    description:
      "Integração de sistemas, automação de processos e desenvolvimento de sistemas sob medida para pequenas e médias empresas.",
    founder: { "@id": `${siteUrl}/#pedro` },
    address: {
      "@type": "PostalAddress",
      addressLocality: "Hortolândia",
      addressRegion: "SP",
      addressCountry: "BR",
    },
    areaServed: [
      { "@type": "City", name: "Hortolândia" },
      { "@type": "City", name: "Campinas" },
      { "@type": "City", name: "Sumaré" },
      { "@type": "City", name: "Indaiatuba" },
      { "@type": "AdministrativeArea", name: "Região Metropolitana de Campinas" },
    ],
    sameAs: [
      "https://linkedin.com/in/pedro-cordeiro",
      "https://github.com/PClima",
    ],
  },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- SEO básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"}
    />
    <meta name="author" content="Pedro Cordeiro Lima" />
    <meta name="theme-color" content="#F5F1E8" />
    <meta name="geo.region" content="BR-SP" />
    <meta name="geo.placename" content="Hortolândia" />
    <link rel="alternate" hreflang="pt-BR" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:site_name" content="Pedro Cordeiro Lima" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pedro Cordeiro Lima — Desenvolvedor e Integrador de Sistemas" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={resolvedOgDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Pedro Cordeiro Lima — Desenvolvedor e Integrador de Sistemas" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
