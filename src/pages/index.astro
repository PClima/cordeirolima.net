---
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource/hanken-grotesk/400.css";
import "@fontsource/hanken-grotesk/500.css";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import profileImg from "../assets/hero.jpg";
import ibmLogo from "../assets/logo-ibm.png";
import boschLogo from "../assets/logo-bosch.png";
import maxionLogo from "../assets/logo-maxion.png";
import finplanImg from "../assets/project-finplan.png";
import laudosImg from "../assets/project-laudos.png";

const experience = [
  {
    logo: ibmLogo,
    alt: "IBM",
    text: "Plataforma de análise de dados e atualização fiscal de sistemas legados",
  },
  {
    logo: boschLogo,
    alt: "Bosch",
    text: "Plataforma de chatbots com IA generativa",
  },
  {
    logo: maxionLogo,
    alt: "Greenbrier Maxion",
    text: "Intranet corporativa e sistema de tickets para fábrica e administrativo",
  },
];

const projects = [
  {
    n: "01",
    name: "Finplan",
    img: finplanImg,
    alt: "Dashboard do Finplan",
    desc: "Dashboard financeiro para controle familiar, com acompanhamento das finanças e gráficos para análise.",
    stack: ["PostgreSQL", "Node.js", "React", "Tailwind"],
  },
  {
    n: "02",
    name: "Portal de Laudos",
    img: laudosImg,
    alt: "Tela do Portal de Laudos",
    desc: "Portal para acompanhamento e geração de laudos técnicos de engenharia.",
    stack: ["PostgreSQL", "React", "Next", "Tailwind"],
  },
];
---

<Layout>
  <div class="page">
    <div class="glow" id="glow" aria-hidden="true"></div>

    <aside class="site-aside">
      <div>
        <div class="brand">
          <svg width="24" height="24" viewBox="0 0 52 52" aria-hidden="true">
            <circle cx="15" cy="26" r="6" fill="#1A1916"></circle>
            <circle cx="37" cy="26" r="6" fill="#3B6D11"></circle>
            <path
              d="M21 26 Q26 13 31 26"
              stroke="#1A1916"
              stroke-width="2"
              fill="none"
              stroke-linecap="round"></path>
            <path
              d="M21 26 Q26 39 31 26"
              stroke="#3B6D11"
              stroke-width="2"
              fill="none"
              stroke-linecap="round"></path>
          </svg>
          <div class="brand-name">Pedro Lima</div>
        </div>
        <div class="brand-role">Desenvolvedor &amp; integrador de sistemas</div>

        <nav class="site-nav" aria-label="Navegação principal">
          <a href="#sobre"><span></span>Sobre</a>
          <a href="#experiencia"><span></span>Experiência</a>
          <a href="#projetos"><span></span>Projetos</a>
          <a href="#contato"><span></span>Contato</a>
        </nav>
      </div>

      <div class="site-social">
        <a href="mailto:pedro@cordeirolima.net" aria-label="Email">
          <svg
            width="19"
            height="19"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            ><rect x="3" y="5" width="18" height="14" rx="1.5"></rect><path
              d="M4 6.5l8 6.5 8-6.5"></path></svg
          >
        </a>
        <a
          href="https://linkedin.com/in/pedro-cordeiro"
          target="_blank"
          rel="noopener"
          aria-label="LinkedIn"
        >
          <svg
            width="19"
            height="19"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            ><rect x="3" y="3" width="18" height="18" rx="2"></rect><line
              x1="7.5"
              y1="10"
              x2="7.5"
              y2="16.5"></line><line x1="7.5" y1="7" x2="7.5" y2="7.05"
            ></line><path
              d="M11.5 16.5V12.7c0-1.5 1-2.7 2.5-2.7s2.5 1.2 2.5 2.7v3.8"
            ></path></svg
          >
        </a>
        <a
          href="https://github.com/PClima"
          target="_blank"
          rel="noopener"
          aria-label="GitHub"
        >
          <svg
            width="19"
            height="19"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            ><path
              d="M12 2a10 10 0 0 0-3.16 19.5c.5.1.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.03a9.6 9.6 0 0 1 5 0c1.91-1.3 2.75-1.03 2.75-1.03.55 1.37.2 2.39.1 2.64.64.7 1.03 1.6 1.03 2.69 0 3.84-2.35 4.68-4.58 4.93.36.31.68.92.68 1.85v2.74c0 .26.18.57.69.48A10 10 0 0 0 12 2z"
            ></path></svg
          >
        </a>
      </div>
    </aside>

    <main class="site-main">
      <section class="hero-section">
        <div class="hero-grid">
          <div>
            <h1 class="hero-title">
              Construo os sistemas que sua empresa não tem tempo de construir.
            </h1>
            <p class="hero-sub">
              Integro e automatizo os processos da sua empresa — sem você
              precisar contratar uma equipe de TI pra isso.
            </p>
          </div>
          <div class="hero-photo-wrap">
            <div class="hero-photo">
              <Image
                src={profileImg}
                alt="Pedro Lima"
                width={720}
                height={1080}
                quality={80}
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <div class="hero-corner"></div>
          </div>
        </div>
      </section>

      <section id="sobre" class="reveal about">
        <h2>Sobre</h2>
        <p>
          Full-stack, com passagem por empresas como IBM e Bosch em projetos de
          sistemas críticos e regulatórios. Aplico essa bagagem em projetos fora
          do universo corporativo — sem squad gigante, direto ao ponto, pra
          pequena empresa.
        </p>
        <p class="about-local">
          Baseado em Hortolândia, SP, atendo empresas de Campinas e região
          presencialmente e de todo o Brasil de forma remota.
        </p>
      </section>

      <section id="experiencia" class="reveal experience">
        <h2>Experiência</h2>
        <div class="exp-list">
          {
            experience.map((e) => (
              <div class="exp-row">
                <Image
                  src={e.logo}
                  alt={e.alt}
                  height={60}
                  quality={85}
                  class="exp-logo"
                />
                <span>{e.text}</span>
              </div>
            ))
          }
        </div>
      </section>

      <section id="projetos" class="projects">
        <h2>Projetos</h2>
        {
          projects.map((p, i) => (
            <div class:list={["reveal", "proj-row", { flip: i % 2 === 1 }]}>
              <div class="proj-text">
                <div class="proj-n">{p.n}</div>
                <h3>{p.name}</h3>
                <p>{p.desc}</p>
                <div class="chips">
                  {p.stack.map((s) => (
                    <span>{s}</span>
                  ))}
                </div>
              </div>
              <div class="proj-img">
                <Image
                  src={p.img}
                  alt={p.alt}
                  width={900}
                  quality={80}
                  loading="lazy"
                />
              </div>
            </div>
          ))
        }
      </section>

      <section id="contato" class="reveal contact">
        <h2>Contato</h2>
        <p>Tem um processo manual que devia ser automático? Vamos conversar.</p>
        <div class="contact-links">
          <a
            href="mailto:pedro@cordeirolima.net"
            class="contact-mail contact-wa"
          >
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
              ><rect x="3" y="5" width="18" height="14" rx="1.5"></rect><path
                d="M4 6.5l8 6.5 8-6.5"></path></svg
            >
            pedro@cordeirolima.net
          </a>
          <a
            href="https://wa.me/5519993748304?text=Ol%C3%A1%20Pedro%2C%20vim%20pelo%20seu%20site."
            target="_blank"
            rel="noopener"
            class="contact-mail contact-wa"
            aria-label="WhatsApp +55 19 99374-8304"
          >
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              ><path
                d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zM12.05 21.8h-.01a9.9 9.9 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.9-9.88 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.89 9.88zM20.52 3.45A11.8 11.8 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.9 0-3.18-1.24-6.17-3.48-8.45z"
              ></path></svg
            >
            (19) 99374-8304
          </a>
        </div>
      </section>
    </main>
  </div>
</Layout>

<script>
  const glow = document.getElementById("glow");
  if (glow && window.matchMedia("(hover: hover)").matches) {
    window.addEventListener("mousemove", (e) => {
      glow.style.transform = `translate(${e.clientX - 260}px, ${e.clientY - 260}px)`;
      glow.style.opacity = "1";
    });
    document.documentElement.addEventListener("mouseleave", () => {
      glow.style.opacity = "0";
    });
  }

  const els = document.querySelectorAll<HTMLElement>(".reveal");
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("in");
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 },
    );
    els.forEach((el) => io.observe(el));
  } else {
    els.forEach((el) => el.classList.add("in"));
  }
</script>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  body {
    background: #f5f1e8 !important;
  }
  ::selection {
    background: #f3dfd3;
  }
</style>

<style>
  .page {
    --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
    --accent: #c1502e;
    --line: #e4dcc9;
    background: #f5f1e8;
    color: #1c1a17;
    font-family: "Hanken Grotesk", sans-serif;
    min-height: 100vh;
    position: relative;
  }
  .page a {
    color: var(--accent);
    text-decoration: none;
  }
  .page a:hover {
    color: #8c3a20;
  }
  h1,
  h2,
  h3 {
    font-family: "Instrument Serif", serif;
    font-weight: 400;
  }

  .glow {
    position: fixed;
    top: 0;
    left: 0;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    background: radial-gradient(
      circle,
      rgba(193, 80, 46, 0.1) 0%,
      rgba(193, 80, 46, 0) 70%
    );
    transform: translate(-260px, -260px);
    transition: opacity 400ms ease;
  }

  /* Sidebar */
  .site-aside {
    position: fixed;
    top: 0;
    left: 0;
    width: 320px;
    height: 100vh;
    padding: 56px 44px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
    border-right: 1px solid var(--line);
    z-index: 1;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .brand svg {
    flex-shrink: 0;
  }
  .brand-name {
    font-family: "Instrument Serif", serif;
    font-size: 30px;
    line-height: 1.1;
  }
  .brand-role {
    font-size: 15px;
    color: #6b655a;
    margin-top: 6px;
    max-width: 210px;
    line-height: 1.5;
  }
  .site-nav {
    margin-top: 64px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .site-nav a {
    color: #1c1a17;
    font-size: 15px;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: color 220ms var(--ease);
  }
  .site-nav a span {
    width: 22px;
    height: 1px;
    background: #8a7f6e;
    transition:
      background 220ms var(--ease),
      width 220ms var(--ease);
  }
  .site-nav a:hover {
    color: var(--accent);
  }
  .site-nav a:hover span {
    background: var(--accent);
    width: 30px;
  }
  .site-social {
    display: flex;
    gap: 20px;
  }
  .site-social a {
    color: #1c1a17;
    display: inline-block;
    transition:
      color 220ms var(--ease),
      transform 220ms var(--ease);
  }
  .site-social a:hover {
    color: var(--accent);
    transform: translateY(-2px);
  }

  /* Main */
  .site-main {
    margin-left: 320px;
    padding: 0 72px;
    position: relative;
    z-index: 1;
  }

  .hero-section {
    min-height: 92vh;
    display: flex;
    align-items: center;
    padding: 80px 0 40px;
    position: relative;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 56px;
    align-items: center;
    width: 100%;
    max-width: 1120px;
  }
  .hero-title {
    font-size: 56px;
    line-height: 1.12;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .hero-sub {
    font-size: 19px;
    line-height: 1.6;
    color: #4a453c;
    margin: 28px 0 0;
    max-width: 46ch;
  }
  .hero-photo-wrap {
    position: relative;
  }
  .hero-photo {
    width: 100%;
    aspect-ratio: 3 / 4;
    margin-left: 24px;
    overflow: hidden;
    border-radius: 2px;
    background: var(--line);
  }
  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.06) brightness(1.05);
    transition: transform 400ms var(--ease);
  }
  .hero-photo:hover :global(img) {
    transform: scale(1.035);
  }
  .hero-corner {
    position: absolute;
    top: -18px;
    left: -18px;
    width: 64px;
    height: 64px;
    border-top: 1px solid var(--accent);
    border-left: 1px solid var(--accent);
  }

  h2 {
    font-size: 30px;
    margin: 0;
  }

  .reveal {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 700ms var(--ease),
      transform 700ms var(--ease),
      background 220ms var(--ease);
  }
  .reveal.in {
    opacity: 1;
    transform: none;
  }

  .about {
    padding: 64px 0 96px;
    max-width: 640px;
  }
  .about h2 {
    margin-bottom: 24px;
  }
  .about p {
    font-size: 17px;
    line-height: 1.75;
    color: #33302a;
    margin: 0;
  }
  .about .about-local {
    margin-top: 16px;
  }

  .experience {
    padding: 32px 0 96px;
  }
  .experience h2 {
    margin-bottom: 40px;
  }
  .exp-list {
    display: flex;
    flex-direction: column;
  }
  .exp-row {
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 28px 0;
    border-top: 1px solid var(--line);
  }
  .exp-row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .exp-row :global(.exp-logo) {
    height: 30px;
    width: 100px;
    object-fit: contain;
    object-position: left;
    filter: grayscale(1) contrast(1.1);
    opacity: 0.82;
    flex-shrink: 0;
    transition:
      opacity 220ms var(--ease),
      filter 220ms var(--ease);
  }
  .exp-row:hover :global(.exp-logo) {
    opacity: 1;
    filter: none;
  }
  .exp-row span {
    font-size: 14px;
    line-height: 1.5;
    color: #6b655a;
  }

  .projects {
    padding: 32px 0 112px;
  }
  .projects h2 {
    margin-bottom: 56px;
  }
  .proj-row {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 64px;
    align-items: center;
    padding: 20px;
    margin: -20px -20px 76px;
    border-radius: 3px;
  }
  .proj-row:last-child {
    margin-bottom: -20px;
  }
  .proj-row:hover {
    background: #efe9da;
  }
  .proj-row.flip {
    grid-template-columns: 0.9fr 1.1fr;
  }
  .proj-img {
    border-radius: 2px;
    overflow: hidden;
    border: 1px solid var(--line);
    transition: border-color 220ms var(--ease);
  }
  .proj-img :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .proj-row:hover .proj-img {
    border-color: var(--accent);
  }
  .proj-row:not(.flip) .proj-img {
    order: -1;
  }
  .proj-n {
    font-family: "Instrument Serif", serif;
    font-style: italic;
    font-size: 16px;
    color: #8a7f6e;
  }
  .proj-text h3 {
    font-size: 28px;
    margin: 6px 0 14px;
    transition: color 220ms var(--ease);
  }
  .proj-row:hover h3 {
    color: var(--accent);
  }
  .proj-text p {
    font-size: 16px;
    line-height: 1.7;
    color: #4a453c;
    margin: 0 0 20px;
    max-width: 38ch;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    font-size: 12.5px;
  }
  .chips span {
    border: 1px solid #c9bfa8;
    border-radius: 4px;
    padding: 4px 9px;
    color: #4a453c;
  }

  .contact {
    padding: 32px 0 120px;
    max-width: 640px;
  }
  .contact h2 {
    margin-bottom: 20px;
  }
  .contact p {
    font-size: 17px;
    line-height: 1.7;
    color: #33302a;
    margin: 0 0 28px;
    max-width: 46ch;
  }
  .contact-mail {
    font-family: "Instrument Serif", serif;
    font-size: 26px;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 4px;
    display: inline-block;
    transition:
      padding-left 220ms var(--ease),
      color 220ms var(--ease);
  }
  .contact-mail:hover {
    padding-left: 6px;
  }
  .contact-wa {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .contact-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
    html {
      scroll-behavior: auto;
    }
  }

  @media (max-width: 860px) {
    .site-aside {
      position: static;
      width: 100%;
      height: auto;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 20px 24px;
      border-right: none;
      border-bottom: 1px solid var(--line);
    }
    .site-nav {
      display: none;
    }
    .site-social {
      gap: 14px;
    }
    .site-main {
      margin-left: 0;
      padding: 0 24px;
    }
    .hero-section {
      min-height: auto;
      padding: 40px 0 32px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-title {
      font-size: 34px;
    }
    .hero-photo-wrap {
      max-width: 240px;
    }
    .hero-photo {
      margin-left: 0;
    }
    .proj-row,
    .proj-row.flip {
      grid-template-columns: 1fr;
      gap: 24px;
      margin: 0 0 48px;
      padding: 0;
    }
    .proj-row:last-child {
      margin-bottom: 0;
    }
    .proj-row:hover {
      background: none;
    }
    .proj-row .proj-img,
    .proj-row:not(.flip) .proj-img {
      order: 1;
    }
    .proj-row .proj-text {
      order: 2;
    }
    .exp-row {
      flex-wrap: wrap;
      gap: 14px;
    }
    .about,
    .contact {
      max-width: none;
    }
  }
</style>
